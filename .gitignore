*.pyc
*.pyo
*.pyd

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/

# Datasets generados (regenerables por script, no se versionan)
datasets/raw/*.npz
datasets/processed/*
!datasets/processed/.gitkeep

# Models
*.pth
*.pt
*.ckpt
# PPO controller: pesos SB3 (.zip) y evaluaciones de EvalCallback (.npz);
# los .json de hiperparámetros junto a cada checkpoint sí se versionan
models/checkpoints/controller/*.zip
models/checkpoints/controller/*.npz
models/checkpoints/controller_direct/*.zip
models/checkpoints/controller_direct/*.npz
models/checkpoints/controller/*.pkl
models/checkpoints/controller_direct/*.pkl
# Verificación de 3x presupuesto del RL directo (30,000 pasos): archivada, no oficial
models/checkpoints/controller_direct_30k/*.zip
models/checkpoints/controller_direct_30k/*.npz
models/checkpoints/controller_direct_30k/*.pkl

# Logs
logs/

# Evaluation figures (generated)
results/
# Versioned evaluation results (per-episode JSON/CSV behind the published tables)
!docs/results/

external_sumo_rl/
